{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://finance-agent/golden-task-set/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixtureVersion", "seed", "sourceVersion", "ruleSetVersion", "packetSchemaVersion", "scenarios"],
  "properties": {
    "fixtureVersion": { "type": "string" },
    "seed": { "type": "integer", "minimum": 0 },
    "sourceVersion": { "type": "string" },
    "ruleSetVersion": { "type": "string" },
    "packetSchemaVersion": { "type": "string" },
    "scenarios": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceScenario", "expectedCoverage", "expectedFinding", "expectedWitness", "expectedPacketSections"],
        "properties": {
          "id": { "type": "string" },
          "sourceScenario": { "type": "string" },
          "expectedCoverage": { "type": "string" },
          "expectedFinding": { "type": "string" },
          "expectedWitness": { "type": "string" },
          "expectedPacketSections": { "type": "array", "minItems": 10, "items": { "type": "string" } }
        }
      }
    }
  }
}
