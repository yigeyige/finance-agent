{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://error-response/1.0.0",
  "title": "Standard Error Response",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "traceId", "retryClass"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{3,80}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "retryClass": {
      "type": "string",
      "enum": ["NOT_RETRYABLE", "SAME_APPROVAL_RETRY", "NEW_APPROVAL_REQUIRED", "MANUAL_RECONCILIATION"]
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {"type": "string", "maxLength": 200},
        "reason": {"type": "string", "maxLength": 500}
      }
    }
  }
}
