{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://task-intake-response/1.0.0",
  "title": "Task intake response",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "title", "status", "rowVersion", "createdAt"],
  "properties": {
    "taskId": {"type": "string", "format": "uuid"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "status": {"type": "string", "enum": ["DRAFT", "WAITING_SCOPE_CONFIRMATION", "READY"]},
    "rowVersion": {"type": "integer", "minimum": 0},
    "currentScopeRevisionId": {"type": ["string", "null"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "premiseId": {"type": ["string", "null"]},
    "scopeRevisionNo": {"type": ["integer", "null"], "minimum": 1},
    "scopeDigest": {"type": ["string", "null"]}
  }
}
