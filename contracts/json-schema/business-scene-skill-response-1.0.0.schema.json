{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://business-scene-skill-response/1.0.0",
  "title": "Business scene Skill response",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["skillId", "name", "investigationPrompt", "decisionPacketPrompt", "processArtifactPrompt", "createdBy", "updatedAt"],
  "properties": {
    "skillId": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "investigationPrompt": {"type": "string", "minLength": 1, "maxLength": 8000},
    "decisionPacketPrompt": {"type": ["string", "null"], "maxLength": 2000},
    "processArtifactPrompt": {"type": ["string", "null"], "maxLength": 4000},
    "createdBy": {"type": "string", "format": "uuid"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
