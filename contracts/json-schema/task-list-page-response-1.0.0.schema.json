{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://task-list-page-response/1.0.0",
  "title": "Task list page response",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "total", "page", "pageSize"],
  "properties": {
    "items": {"type": "array", "items": {"$ref": "task-list-item-1.0.0.schema.json"}},
