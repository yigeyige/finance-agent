{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://step-proposal-response/1.0.0",
  "title": "Step proposal response",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "status", "rowVersion", "scopeRevisionId", "currentStepId", "steps"],
  "properties": {
    "taskId": {"type": "string", "format": "uuid"},
    "status": {"type": "string", "minLength": 1, "maxLength": 100},
    "rowVersion": {"type": "integer", "minimum": 0},
    "scopeRevisionId": {"type": ["string", "null"], "format": "uuid"},
    "currentStepId": {"type": ["string", "null"], "format": "uuid"},
    "steps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["stepId", "sequenceNo", "goal", "recommended", "status"], "properties": {"stepId": {"type": "string", "format": "uuid"}, "sequenceNo": {"type": "integer", "minimum": 1}, "goal": {"type": "string", "minLength": 1, "maxLength": 1000}, "recommended": {"type": "boolean"}, "status": {"type": "string", "minLength": 1, "maxLength": 100}}}}
  }
}
