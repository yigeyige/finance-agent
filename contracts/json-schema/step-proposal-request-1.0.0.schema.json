{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://step-proposal-request/1.0.0",
  "title": "Step Proposal Request",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps"],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goal", "recommended"],
        "properties": {
          "goal": {"type": "string", "minLength": 1, "maxLength": 1000},
          "recommended": {"type": "boolean"}
        }
      }
    }
  }
}
