{
  "openapi": "3.1.0",
  "info": {
    "title": "Finance Operations Agent API",
    "version": "1.3.0",
    "description": "财务共享智能运维 Agent P0 API 契约。"
  },
  "x-contract-version": "1.3.0",
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "operationId": "listVisibleTasks",
        "security": [{"unifiedAuth": ["OPERATOR"]}],
        "parameters": [
          {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "default": 1}},
          {"name": "pageSize", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}},
          {"name": "status", "in": "query", "required": false, "schema": {"type": "string", "enum": ["DRAFT", "WAITING_SCOPE_CONFIRMATION", "READY", "WAITING_STEP_APPROVAL", "RUNNING_STEP", "ANALYZING", "WAITING_PROFESSIONAL_CONFIRMATION", "DRAFT_PACKET", "WAITING_REVIEW", "RECHECKING_SCOPE", "READY_TO_PUBLISH", "PUBLISHED", "HANDED_OFF", "CLOSED", "PAUSED_MODEL_UNAVAILABLE", "PAUSED_BUDGET", "PAUSED_SOURCE_UNAVAILABLE", "STALE_APPROVAL", "FAILED_RECOVERABLE", "CANCELLED"]}},
          {"name": "keyword", "in": "query", "required": false, "schema": {"type": "string", "maxLength": 100}}
        ],
        "responses": {
          "200": {"description": "Tasks visible to the current identity", "content": {"application/json": {"schema": {"$ref": "../json-schema/task-list-page-response-1.0.0.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      },
      "post": {
        "operationId": "createTask",
        "security": [
          {
            "unifiedAuth": ["OPERATOR"]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/ActorUserId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../json-schema/task-draft-request-1.0.0.schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created in DRAFT state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/task-intake-response-1.0.0.schema.json"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "422": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
    "/api/v1/tasks/{taskId}/premises": {
      "post": {
        "operationId": "addTaskPremise",
        "security": [
          {
            "unifiedAuth": ["OPERATOR"]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/ActorUserId"
          },
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../json-schema/task-premise-request-1.0.0.schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Premise appended"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
    "/api/v1/tasks/{taskId}/scope-confirmations": {
      "post": {
        "operationId": "confirmTaskScope",
        "security": [
          {
            "unifiedAuth": ["OPERATOR"]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/ActorUserId"
          },
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../json-schema/scope-confirmation-request-1.0.0.schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable scope revision confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/task-intake-response-1.0.0.schema.json"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
    "/api/v1/tasks/{taskId}/step-approvals": {
      "post": {
        "operationId": "createStepApproval",
        "security": [
          {
            "unifiedAuth": ["OPERATOR"]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/ActorUserId"
          },
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../json-schema/step-approval-request-1.0.0.schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Approval revision created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/step-approval-response-1.0.0.schema.json"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
    "/api/v1/tasks/{taskId}/step-proposals": {
      "post": {
        "operationId": "createStepProposal",
        "security": [
          {
            "unifiedAuth": ["OPERATOR"]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/ActorUserId"
          },
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../json-schema/step-proposal-request-1.0.0.schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bounded step proposal created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/step-proposal-response-1.0.0.schema.json"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
    "/api/v1/tasks/{taskId}/publish": {
      "post": {
        "operationId": "publishPacket",
        "security": [
          {
            "unifiedAuth": ["OPERATOR"]
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["draftId", "reviewedContentDigest", "reviewId", "expectedRowVersion"],
                "properties": {
                  "draftId": {"type": "string", "format": "uuid"},
                  "reviewedContentDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "reviewId": {"type": "string", "format": "uuid"},
                  "expectedRowVersion": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable revision published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../json-schema/decision-packet-1.0.0.schema.json"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "412": {
            "$ref": "#/components/responses/ContractError"
          }
        }
      }
    },
    "/api/v1/tasks/{taskId}": {
      "get": {
        "operationId": "getTaskDetail",
        "security": [{"unifiedAuth": ["OPERATOR"]}],
        "parameters": [{"$ref": "#/components/parameters/TaskId"}],
        "responses": {
          "200": {"description": "Readonly business, scope, and plan detail", "content": {"application/json": {"schema": {"$ref": "../json-schema/task-detail-response-1.0.0.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/v1/tasks/{taskId}/step-proposals/{stepId}": {
      "patch": {
        "operationId": "reviseStepProposal",
        "security": [{"unifiedAuth": ["OPERATOR"]}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/ActorUserId"}, {"$ref": "#/components/parameters/TaskId"}, {"$ref": "#/components/parameters/StepId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../json-schema/step-proposal-revision-request-1.0.0.schema.json"}}}},
        "responses": {
          "200": {"description": "Current proposal step revised", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["stepId", "sequenceNo", "goal", "recommended", "status"], "properties": {"stepId": {"type": "string", "format": "uuid"}, "sequenceNo": {"type": "integer", "minimum": 1}, "goal": {"type": "string", "minLength": 1, "maxLength": 1000}, "recommended": {"type": "boolean"}, "status": {"type": "string", "minLength": 1, "maxLength": 100}}}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/ContractError"}
        }
      }
    },
    "/api/v1/business-scene-skills": {
      "get": {
        "operationId": "listBusinessSceneSkills",
        "security": [{"unifiedAuth": ["OPERATOR"]}],
        "responses": {
          "200": {"description": "Maintained business scene Skills", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "../json-schema/business-scene-skill-response-1.0.0.schema.json"}}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      },
      "post": {
        "operationId": "createBusinessSceneSkill",
        "security": [{"unifiedAuth": ["OPERATOR"]}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../json-schema/business-scene-skill-request-1.0.0.schema.json"}}}},
        "responses": {
          "201": {"description": "Business scene Skill created", "content": {"application/json": {"schema": {"$ref": "../json-schema/business-scene-skill-response-1.0.0.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "422": {"$ref": "#/components/responses/ContractError"}
        }
      }
    },
    "/api/v1/business-scene-skills/{skillId}": {
      "put": {
        "operationId": "updateBusinessSceneSkill",
        "security": [{"unifiedAuth": ["OPERATOR"]}],
        "parameters": [{"$ref": "#/components/parameters/SkillId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../json-schema/business-scene-skill-request-1.0.0.schema.json"}}}},
        "responses": {
          "200": {"description": "Business scene Skill updated", "content": {"application/json": {"schema": {"$ref": "../json-schema/business-scene-skill-response-1.0.0.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "422": {"$ref": "#/components/responses/ContractError"}
        }
      },
      "delete": {
        "operationId": "deleteBusinessSceneSkill",
        "security": [{"unifiedAuth": ["OPERATOR"]}],
        "parameters": [{"$ref": "#/components/parameters/SkillId"}],
        "responses": {
          "204": {"description": "Business scene Skill deleted"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/v1/model-configurations": {
      "get": {
        "operationId": "listModelConfigurations",
        "security": [{"unifiedAuth": ["PLATFORM_ADMIN"]}],
        "responses": {
          "200": {"description": "Model connections without API Key values", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "../json-schema/model-connection-config-response-1.0.0.schema.json"}}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      },
      "post": {
        "operationId": "createModelConfiguration",
        "security": [{"unifiedAuth": ["PLATFORM_ADMIN"]}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../json-schema/model-connection-config-request-1.0.0.schema.json"}}}},
        "responses": {
          "201": {"description": "Model connection created", "content": {"application/json": {"schema": {"$ref": "../json-schema/model-connection-config-response-1.0.0.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "422": {"$ref": "#/components/responses/ContractError"}
        }
      }
    },
    "/api/v1/model-configurations/{configId}": {
      "put": {
        "operationId": "updateModelConfiguration",
        "security": [{"unifiedAuth": ["PLATFORM_ADMIN"]}],
        "parameters": [{"$ref": "#/components/parameters/ConfigId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../json-schema/model-connection-config-request-1.0.0.schema.json"}}}},
        "responses": {
          "200": {"description": "Model connection updated", "content": {"application/json": {"schema": {"$ref": "../json-schema/model-connection-config-response-1.0.0.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "422": {"$ref": "#/components/responses/ContractError"}
        }
      }
    },
    "/api/v1/model-configurations/{configId}/enable": {
      "post": {
        "operationId": "enableModelConfiguration",
        "security": [{"unifiedAuth": ["PLATFORM_ADMIN"]}],
        "parameters": [{"$ref": "#/components/parameters/ConfigId"}],
        "responses": {
          "204": {"description": "Model connection becomes the only enabled connection"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/v1/model-configurations/{configId}/disable": {
      "post": {
        "operationId": "disableModelConfiguration",
        "security": [{"unifiedAuth": ["PLATFORM_ADMIN"]}],
        "parameters": [{"$ref": "#/components/parameters/ConfigId"}],
        "responses": {
          "204": {"description": "Model connection is disabled and remains available for later re-enable"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/v1/tasks/{taskId}/model-interactions/guidance": {
      "post": {
        "operationId": "generateBusinessGuidance",
        "security": [{"unifiedAuth": ["OPERATOR"]}],
        "parameters": [{"$ref": "#/components/parameters/TaskId"}],
        "requestBody": {"required": false, "content": {"application/json": {"schema": {"$ref": "../json-schema/business-guidance-request-1.0.0.schema.json"}}}},
        "responses": {
          "200": {"description": "Editable business handling draft and model metadata", "content": {"application/json": {"schema": {"$ref": "../json-schema/business-guidance-response-1.0.0.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "422": {"$ref": "#/components/responses/ContractError"}
        }
      }
    },
    "/api/v1/tasks/{taskId}/model-interactions/plan": {
      "post": {
        "operationId": "generateModelPlan",
        "security": [{"unifiedAuth": ["OPERATOR"]}],
        "parameters": [{"$ref": "#/components/parameters/TaskId"}],
        "responses": {
          "200": {"description": "Recommended business plan with model metadata", "content": {"application/json": {"schema": {"$ref": "../json-schema/model-plan-response-1.0.0.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/v1/tasks/{taskId}/model-interactions/evidence-analysis": {
      "post": {
        "operationId": "analyzeEvidenceWithModel",
        "security": [{"unifiedAuth": ["OPERATOR"]}],
        "parameters": [{"$ref": "#/components/parameters/TaskId"}],
        "responses": {
          "200": {"description": "Desensitized evidence analysis and model metadata", "content": {"application/json": {"schema": {"$ref": "../json-schema/model-evidence-analysis-response-1.0.0.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "unifiedAuth": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://auth.example.invalid/.well-known/openid-configuration"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 200
        }
      },
      "ActorUserId": {
        "name": "X-Actor-User-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "TaskId": {
        "name": "taskId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "SkillId": {
        "name": "skillId",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "format": "uuid"}
      },
      "ConfigId": {
        "name": "configId",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "format": "uuid"}
      },
      "StepId": {
        "name": "stepId",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "format": "uuid"}
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication is missing or invalid",
        "content": {"application/json": {"schema": {"$ref": "../json-schema/error-response-1.0.0.schema.json"}}}
      },
      "Forbidden": {
        "description": "Current identity does not have the required role or permission",
        "content": {"application/json": {"schema": {"$ref": "../json-schema/error-response-1.0.0.schema.json"}}}
      },
      "NotFound": {
        "description": "Requested resource does not exist or is not visible to the current identity",
        "content": {"application/json": {"schema": {"$ref": "../json-schema/error-response-1.0.0.schema.json"}}}
      },
      "Conflict": {
        "description": "Task, scope, approval, or idempotency version conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../json-schema/error-response-1.0.0.schema.json"
            }
          }
        }
      },
      "ContractError": {
        "description": "Request does not satisfy the published contract",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../json-schema/error-response-1.0.0.schema.json"
            }
          }
        }
      }
    }
  }
}
